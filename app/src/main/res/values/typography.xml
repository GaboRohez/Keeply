<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      textFontWeight/textStyle stay at normal/400 so Material does not rematch
      weights across faces. Each Onest TTF uses a unique family name
      (OnestBold, OnestMedium, …) so bold/medium/regular stay distinct.
    -->
    <style name="TextAppearance.Keeply" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/onest_regular_file</item>
        <item name="android:fontFamily">@font/onest_regular_file</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Keeply.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/onest_bold_file</item>
        <item name="android:fontFamily">@font/onest_bold_file</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Keeply.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/onest_bold_file</item>
        <item name="android:fontFamily">@font/onest_bold_file</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Keeply.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/onest_bold_file</item>
