<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ShapeAppearance.Keeply.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Keeply.Search" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Keeply.SmallCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Keeply.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="MaterialAlertDialog.Keeply" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.Keeply.Dialog</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Keeply.Dialog</item>
        <!-- Surface sólido: evita el macro M3 teñido de primary -->
        <item name="backgroundTint">@color/keeply_surface</item>
    </style>

    <!-- Solo shape/colores: estilos de título/botón rompían layout_width en m3_alert_dialog -->
    <style name="ThemeOverlay.Keeply.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Keeply</item>
        <!-- Sin esto, MaterialShapeDrawable tintea el fondo con colorPrimary (azul) -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@android:color/transparent</item>
        <item name="android:colorBackground">@color/keeply_surface</item>
        <item name="colorSurface">@color/keeply_surface</item>
        <item name="colorSurfaceBright">@color/keeply_surface</item>
        <item name="colorSurfaceContainer">@color/keeply_surface</item>
        <item name="colorSurfaceContainerLow">@color/keeply_surface</item>
        <item name="colorSurfaceContainerHigh">@color/keeply_surface</item>
        <item name="colorSurfaceContainerHighest">@color/keeply_surface</item>
        <item name="colorOnSurface">@color/keeply_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/keeply_text_secondary</item>
        <item name="colorPrimary">@color/keeply_primary</item>
    </style>

    <style name="Widget.Keeply.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_filter_background</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="checkedIconVisible">true</item>
        <item name="checkedIconTint">@color/chip_filter_icon</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <!-- Evita el tinte de elevación de Material 3 en cards -->
    <style name="ThemeOverlay.Keeply.WhiteCard" parent="">
        <item name="colorSurface">@color/keeply_surface</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Widget.Keeply.FieldLabel" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">@font/onest_medium_file</item>
        <item name="fontFamily">@font/onest_medium_file</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/keeply_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
