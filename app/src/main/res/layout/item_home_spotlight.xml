<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/keeply_surface"
    app:cardElevation="0dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.Keeply.Card"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="112dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvSpotlightEyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/onest"
            android:maxLines="1"
            android:textColor="@color/keeply_primary"
            android:textFontWeight="600"
            android:textSize="11sp"
            tools:text="Próximo a caducar" />

        <TextView
            android:id="@+id/tvSpotlightTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/onest"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="@color/keeply_text_primary"
            android:textFontWeight="700"
            android:textSize="15sp"
            tools:text="Leche entera" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSpotlightSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/onest"
                android:maxLines="2"
                android:textColor="@color/keeply_text_secondary"
                android:textSize="12sp"
                tools:text="Caduca en 2 días" />

            <TextView
                android:id="@+id/tvSpotlightBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_item_thumb"
                android:fontFamily="@font/onest"
                android:gravity="center"
                android:minWidth="40dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:textColor="@color/keeply_text_primary"
                android:textFontWeight="700"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="2d"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
