<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keeply_background"
    tools:context=".presentation.home.HomeFragment">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:fontFamily="@font/onest_bold_file"
        android:text="@string/home_title"
        android:textColor="@color/keeply_text_primary"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp">

            <!-- Saludo: tipografía limpia, sin card -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:fontFamily="@font/onest_bold_file"
                android:textColor="@color/keeply_text_primary"
                android:textSize="24sp"
                tools:text="Hola, Gabo" />

            <TextView
                android:id="@+id/tvGreetingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:fontFamily="@font/onest_regular_file"
                android:text="@string/home_greeting_subtitle"
                android:textColor="@color/keeply_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvProfileHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:fontFamily="@font/onest_regular_file"
                android:paddingVertical="2dp"
                android:text="@string/home_profile_incomplete"
                android:textColor="@color/keeply_primary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <include
                android:id="@+id/softPrompt"
                layout="@layout/view_soft_prompt" />

            <!-- Resumen -->
            <TextView
                android:id="@+id/tvSummaryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:fontFamily="@font/onest_bold_file"
                android:text="@string/home_summary_section"
                android:textColor="@color/keeply_text_primary"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/statsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/statTotal"
                    layout="@layout/item_home_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/statExpiring"
                    layout="@layout/item_home_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/statLowStock"
                    layout="@layout/item_home_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Destacados -->
            <TextView
                android:id="@+id/tvSpotlightLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:fontFamily="@font/onest_bold_file"
                android:text="@string/home_spotlight_section"
                android:textColor="@color/keeply_text_primary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardNextExpiry"
                    layout="@layout/item_home_spotlight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardLastActivity"
                    layout="@layout/item_home_spotlight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Alertas -->
            <TextView
                android:id="@+id/tvAlertsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:fontFamily="@font/onest_bold_file"
                android:text="@string/home_alerts_section"
                android:textColor="@color/keeply_text_primary"
                android:textSize="16sp" />

            <include
                android:id="@+id/cardExpiredAlert"
                layout="@layout/item_home_alert_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/cardExpiringAlert"
                layout="@layout/item_home_alert_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <include
                android:id="@+id/cardLowStockAlert"
                layout="@layout/item_home_alert_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <include
                android:id="@+id/cardOutOfStockAlert"
                layout="@layout/item_home_alert_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Este mes -->
            <TextView
                android:id="@+id/tvInsightsSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:fontFamily="@font/onest_bold_file"
                android:text="@string/home_insights_section"
                android:textColor="@color/keeply_text_primary"
                android:textSize="16sp" />

            <include
                android:id="@+id/monthlyInsights"
                layout="@layout/view_home_insights" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
