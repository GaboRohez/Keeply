<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/keeply_background"
            app:cardElevation="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Keeply.Search"
            app:strokeWidth="0dp">

            <EditText
                android:id="@+id/etListName"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="@font/onest"
                android:hint="@string/shopping_list_name"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/keeply_text_primary"
                android:textColorHint="@color/keeply_text_tertiary"
                android:textSize="15sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/onest"
            android:text="@string/shopping_auto_include"
            android:textColor="@color/keeply_text_primary"
            android:textFontWeight="600"
            android:textSize="14sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkOutOfStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="@font/onest"
            android:text="@string/shopping_include_out_of_stock" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkLowStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="@font/onest"
            android:text="@string/shopping_include_low_stock" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkExpired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:fontFamily="@font/onest"
            android:text="@string/shopping_include_expired" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/onest"
            android:text="@string/shopping_auto_categories"
            android:textColor="@color/keeply_text_primary"
            android:textFontWeight="600"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="false"
            app:singleSelection="false" />
    </LinearLayout>
</ScrollView>
